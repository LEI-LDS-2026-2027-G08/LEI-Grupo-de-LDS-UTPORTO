<?xml version="1.0" encoding="utf-8"?>
<!-- Regras para Android 12 e posteriores. A sessão (token cifrado) nunca sai do dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sessao.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sessao.xml" />
    </device-transfer>
</data-extraction-rules>
