# =============================================================================
# I069 — Gestão de pacientes (EP-015 a EP-018)
#
# Acrescentar ao http-client.env.json.user:
#   "passwordAux": "..."
#
# Conta usada:
#   aux.carla@clinica-g08.test
# =============================================================================

@emailAux = aux.carla@clinica-g08.test

### Login Auxiliar Veterinário
# @name loginAux
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "{{emailAux}}", "password": "{{passwordAux}}" }

### EP-015 · 200 — listar/pesquisar pacientes por proprietário
GET {{host}}/animais?clienteId=1
Authorization: Bearer {{loginRececao.response.body.$.token}}

### EP-015 · 200 — pesquisa por nome do animal/proprietário
GET {{host}}/animais?pesquisa=Bobi
Authorization: Bearer {{loginVet.response.body.$.token}}

### EP-015 · 200 — filtro por espécie e paginação máxima
GET {{host}}/animais?especie=Cão&pagina=1&tamanho=100
Authorization: Bearer {{loginVet.response.body.$.token}}

### EP-015 · 400 — paginação inválida
GET {{host}}/animais?pagina=0&tamanho=101
Authorization: Bearer {{loginRececao.response.body.$.token}}

### EP-015 · 401 — sem token
GET {{host}}/animais

### EP-015 · 403 — perfil Cliente
GET {{host}}/animais
Authorization: Bearer {{loginCliente.response.body.$.token}}

### EP-016 · 200 — Auxiliar consulta apenas ficha administrativa
GET {{host}}/animais/1
Authorization: Bearer {{loginAux.response.body.$.token}}

### EP-016 · 404 — animal inexistente
GET {{host}}/animais/999999
Authorization: Bearer {{loginRececao.response.body.$.token}}

### EP-016 · 401 — sem token
GET {{host}}/animais/1

### EP-016 · 403 — perfil Cliente
GET {{host}}/animais/1
Authorization: Bearer {{loginCliente.response.body.$.token}}

