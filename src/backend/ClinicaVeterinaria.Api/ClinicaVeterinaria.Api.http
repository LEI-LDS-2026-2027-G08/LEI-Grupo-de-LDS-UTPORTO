POST {{host}}/utilizadores
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "nome": "X", "email": "fraca.{{$random.uuid}}@clinica.test", "perfil": "Rececionista", "passwordInicial": "12345678" }

### EP-006 · 400 — perfil fora da enumeração
POST {{host}}/utilizadores
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "nome": "X", "email": "perfil.{{$random.uuid}}@clinica.test", "perfil": "Gerente", "passwordInicial": "Temp#2026" }

